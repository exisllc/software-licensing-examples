# Copy to .env (git-ignored) and fill in. Environment variables override this file.
EXISONE_BASE_URL=https://www.exisone.com
# This token stays on your server, but it still only needs the "verify" permission.
EXISONE_ACCESS_TOKEN=exo_at_REPLACE_ME
# Product name exactly as in your ExisOne dashboard
EXISONE_PRODUCT=Acme Reports
PORT=3000
