# Copy to .env (git-ignored) and fill in. Environment variables override this file.
EXISONE_BASE_URL=https://www.exisone.com
# Access token with ONLY the "verify" permission. It ships with your app, so treat it as public.
EXISONE_ACCESS_TOKEN=exo_at_REPLACE_ME
# Product name exactly as in your ExisOne dashboard
EXISONE_PRODUCT=Acme Sketch
# Opened by the Buy / Renew button
EXISONE_BUY_URL=https://example.com/buy/acme-sketch
# Days the app keeps working offline after the last successful check
EXISONE_GRACE_DAYS=7
